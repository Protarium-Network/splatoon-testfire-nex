# Network listeners. SECURE_SERVER_HOST must be reachable by the Wii U client;
# set it to this machine's LAN or public address (the example is RFC 5737 docs).
PN_GLOBAL_TESTFIRE_AUTHENTICATION_SERVER_PORT=60000
PN_GLOBAL_TESTFIRE_SECURE_SERVER_HOST=192.0.2.10
PN_GLOBAL_TESTFIRE_SECURE_SERVER_PORT=60001

# Matchmaking state. The common Pretendo protocol handlers create their own
# schemas and tables on first start.
PN_GLOBAL_TESTFIRE_POSTGRES_URI=postgres://testfire:testfire@127.0.0.1:5432/testfire?sslmode=disable

# Standalone preservation mode uses settings.json for NEX account passwords
# and does not contact Pretendo account/friends gRPC services.
PN_GLOBAL_TESTFIRE_LOCAL_MODE=1
PN_GLOBAL_TESTFIRE_SETTINGS_PATH=settings.json

# The historical Testfire server build string is not present in Gambit.rpx.
# Keep this unset until a packet capture provides the original value.
PN_GLOBAL_TESTFIRE_NEX_BUILD_NAME=

# Optional basic UDP health endpoint.
# PN_GLOBAL_TESTFIRE_HEALTH_CHECK_PORT=60002
